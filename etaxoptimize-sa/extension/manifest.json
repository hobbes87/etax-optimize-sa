{
  "manifest_version": 3,
  "name": "eTaxOptimize SA — Guided SARS eFiling Auto-Fill",
  "version": "1.0.0",
  "description": "Populates verified SARS ITR12 source-code boxes locally in your browser without storing credentials.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://secure.sarsefiling.co.za/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://secure.sarsefiling.co.za/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
