{
  "manifest_version": 3,
  "name": "eTaxOptimize SA Document Helper",
  "version": "1.0.0",
  "description": "Prepares tax-document forms for use with eTaxOptimize SA.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}